# Frontend (Next.js)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_FACTORY_CONTRACT_ID=CBFMYDQDRJGOXYRKBDBBS2LQTAHHYYXUDAPGZVZJ2MEYJWHT3RGUSEJP
NEXT_PUBLIC_BONDING_CURVE_CONTRACT_ID=CD7Q2RTRO7L2TC4WJSNVNONIWZFHVGAZGEXFI4INEK4QMEJ3JO3K4FRN
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
# Reown AppKit (EVM wallets on /auth). Get one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Frontend — Arc (EVM) deployment. Leave these unset to keep running Stellar only;
# set them to expose the EVM chain alongside it in the app.
# Testnet: https://rpc.testnet.arc.io (chain id 5042002)
# Mainnet: https://rpc.mainnet.arc.io (chain id 5042)
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_FACTORY_ADDRESS=
# Quote asset new curves settle in. Use the zero address for the native Arc USDC gas token.
NEXT_PUBLIC_ARC_QUOTE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Scripts (deployer account)
SOROBAN_ACCOUNT=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Scripts — Arc deployment, consumed by scripts/deploy-arc.sh
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_DEPLOY_LABEL=arc-testnet
# Factory admin; defaults to the deployer address when empty.
FACTORY_ADMIN=
# ERC20 quote asset for new curves; empty means the native Arc USDC gas token.
ARC_USDC=
# Deployer private key. Prefer `--ledger` (hardware wallet) for mainnet deployments.
PRIVATE_KEY=
